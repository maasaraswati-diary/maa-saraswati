# Local development settings (git-ignored copy lives at server/.env)

# API port for `npm start`. Not used on Firebase - Cloud Functions assigns its
# own port, and the Firebase CLI rejects a .env that defines PORT.
PORT=4000

# Comma-separated list of browser origins allowed to call the API.
# On Firebase Hosting the site and API share one origin, so this only matters
# for local development.
CLIENT_ORIGIN=http://localhost:5180

# Signs the admin session tokens. Use a long random string in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# The single admin account. Created automatically on first boot.
ADMIN_EMAIL=maasaraswati449@gmail.com
ADMIN_PASSWORD=admin123
