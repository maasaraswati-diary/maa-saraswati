rules_version = '2';

// The website talks to the API through Cloud Functions, which uses the Admin
// SDK and bypasses these rules entirely. That means these rules only matter if
// a browser client ever reads Firestore directly - so we deny everything and
// keep all data access on the server, where it is authenticated and validated.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
