rules_version = '2';

// The browser talks to Firestore directly, so these rules are the security
// boundary for the whole site.
//
//  shop      - the public storefront. A product is copied here ONLY when the shop
//              owner approves it, so the public catalogue is a plain read with no
//              query filter. Safe to open up.
//  products  - every submission, whatever its review state. Private: only the
//              owner and the partner who submitted it can read it.
//  testimonials - the customer reviews on the home page. Public to read,
//              owner-only to write.
//  enquiries - anyone may send one; only the owner can read them.
//  pageContent - the editable text on the About page. Public to read, like the
//              storefront, because the page is public; owner-only to write, so
//              nobody but the shop can put words in the company's mouth.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The shop owner. Sees everything and is the only account that can approve.
    function owner() {
      return signedIn()
        && request.auth.token.email == 'kunalkalia261085@gmail.com';
    }

    // The signed-in partner who owns this document.
    function mine() {
      return signedIn()
        && resource.data.ownerEmail == request.auth.token.email;
    }

    // ---------- shop : the public storefront ----------
    match /shop/{id} {
      // Open to everyone, but only the owner can put anything here.
      allow read: if true;
      allow write: if owner();
    }

    // ---------- products : submissions under review ----------
    match /products/{id} {
      allow get: if resource.data.status == 'approved' || owner() || mine();
      allow list: if owner() || mine();

      // A partner may submit a product. It must start as 'pending' and must be
      // tagged with the submitter's own email, so nobody can post as someone else.
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerEmail == request.auth.token.email;

      // The owner can do anything, including approving. A partner may edit their
      // own product, but only while it is back in 'pending' - this is what makes
      // the owner's approval real.
      allow update: if owner()
        || (mine() && request.resource.data.status == 'pending');

      allow delete: if owner() || mine();
    }

    // ---------- testimonials ----------
    // Public: anyone can read the customer reviews. Only the owner can change
    // them, so a partner can never put words in a customer's mouth.
    match /testimonials/{id} {
      allow read: if true;
      allow write: if owner();
    }

    // ---------- uploads : pictures a partner attached ----------
    // Cloud Storage would need a billing account, so optimised WebP bytes live
    // in Firestore. Anyone must be able to read them, because the storefront
    // shows them. A signed-in partner may add one for themselves; only the owner
    // can change or remove anything, so a partner can never touch the shop's own
    // pictures. The size ceilings keep a document under Firestore's 1 MB limit.
    match /uploads/{id} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.ownerEmail == request.auth.token.email
        && request.resource.data.large.size() < 900000
        && request.resource.data.thumb.size() < 300000;
      allow update, delete: if owner();
    }

    // ---------- pageContent : the About page, written from the panel ----------
    // The About page reads its text from here so the owner can change it without
    // a deploy. Open to read, because the page itself is public - exactly the
    // bargain the storefront gets. Only the owner may write, so a partner cannot
    // rewrite the company's story.
    match /pageContent/{id} {
      allow read: if true;
      allow write: if owner();
    }

    // ---------- enquiries ----------
    match /enquiries/{id} {
      allow read, update, delete: if owner();
      allow create: if true;
    }

    // ---------- user profiles ----------
    match /users/{id} {
      allow read, write: if signedIn() && request.auth.uid == id;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
